local rnd = Random.new()
local function rid()
    local s = "abcdefghijklmnopqrstuvwxyz0123456789"
    local t = {}
    for i = 1, 14 do
        local n = rnd:NextInteger(1, #s)
        t[i] = s:sub(n, n)
    end
    return table.concat(t)
end

