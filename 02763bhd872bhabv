local function makeTag(adornee, maxDist)
    local bb = Instance.new("BillboardGui")
    bb.Name = rid()
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.MaxDistance = maxDist or math.huge
    bb.Adornee = adornee

    local frame = Instance.new("Frame")
    frame.Name = rid()
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
